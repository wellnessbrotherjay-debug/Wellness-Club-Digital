{
  "version": 2,
  "buildCommand": "npm run build --workspace=apps/web",
  "outputDirectory": "apps/web/dist",
  "functions": {
    "api/**/*.ts": {
      "maxDuration": 30,
      "memory": 1024
    }
  },
  "rewrites": [
    { "source": "/v/(.*)", "destination": "/index.html" },
    { "source": "/admin/(.*)", "destination": "/index.html" },
    { "source": "/((?!api|assets|.*\\..*).*)", "destination": "/index.html" }
  ],
  "crons": [
    { "path": "/api/cron/weekly-report",  "schedule": "0 8 * * 1" },
    { "path": "/api/cron/daily-backup",   "schedule": "0 2 * * *" },
    { "path": "/api/cron/sheets-export",  "schedule": "0 * * * *" }
  ]
}
