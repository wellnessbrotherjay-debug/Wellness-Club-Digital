{
    "crons": [
        {
            "path": "/api/cron/weekly-report",
            "schedule": "0 9 * * 1"
        }
    ],
    "rewrites": [
        {
            "source": "/api/(.*)",
            "destination": "/api/$1"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ],
    "devCommand": "npm run dev"
}