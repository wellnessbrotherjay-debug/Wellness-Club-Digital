# Wellness Club Digital - API Environment Configuration
# Copy this file to .env and fill in the values

# Server Configuration
PORT=3001
NODE_ENV=development

# Supabase Configuration
# Found in Supabase Dashboard -> Settings -> API
SUPABASE_URL=your_supabase_project_url
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Google Apps Script (Mirroring)
# Deployment URL of the Google Apps Script
APPS_SCRIPT_URL=your_google_script_deployment_url

# Resend API (Notifications)
# Found in Resend Dashboard -> API Keys
RESEND_API_KEY=re_your_api_key
