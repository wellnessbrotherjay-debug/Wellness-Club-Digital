    "lint": "npm run lint --workspace=apps/web"
  },
  "dependencies": {
    "hono": "^4.7.10",
    "@hono/node-server": "^1.14.4",
    "@supabase/supabase-js": "^2.97.0"
  },
  "devDependencies": {
    "@vercel/node": "^5.1.8",
    "concurrently": "^9.1.2",
    "csv-parse": "^5.6.0"
  }
}
